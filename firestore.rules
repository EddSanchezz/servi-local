rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isModerator() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MODERATOR';
    }

    function isPostOwner(postId) {
      return request.auth != null
        && get(/databases/$(database)/documents/posts/$(postId)).data.providerId == request.auth.uid;
    }

    match /users/{uid} {
      function isValidNewUser() {
        return request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'role', 'points', 'level', 'status', 'createdAtMillis', 'photoUrl'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'email', 'role', 'points', 'level', 'status', 'createdAtMillis'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
          && request.resource.data.role == 'USER'
          && request.resource.data.points == 0
          && request.resource.data.level == 'PRINCIPIANTE'
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.createdAtMillis is int
          && (!('photoUrl' in request.resource.data)
            || request.resource.data.photoUrl == null
            || (request.resource.data.photoUrl is string
              && request.resource.data.photoUrl.size() <= 2048
              && request.resource.data.photoUrl.matches('^https://.*')));
      }

      function levelForPoints(points) {
        return points >= 500 ? 'MAESTRO'
          : points >= 250 ? 'EXPERTO'
          : points >= 100 ? 'PROFESIONAL'
          : 'PRINCIPIANTE';
      }

      function isValidPointGrant() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let eventId = request.resource.data.lastPointEventId;
        let eventPath = /databases/$(database)/documents/users/$(uid)/pointEvents/$(eventId);
        let postId = getAfter(eventPath).data.sourcePostId;
        let postPath = /databases/$(database)/documents/posts/$(postId);
        return request.auth.uid == uid
          && eventId is string
          && changedKeys.hasOnly(['points', 'level', 'lastPointEventId'])
          && changedKeys.hasAll(['points', 'level', 'lastPointEventId'])
          && request.resource.data.points is int
          && resource.data.points is int
          && request.resource.data.points >= 0
          && existsAfter(eventPath)
          && !exists(eventPath)
          && getAfter(eventPath).data.userId == uid
          && getAfter(eventPath).data.eventId == eventId
          && getAfter(eventPath).data.pointsDelta == 50
          && request.resource.data.points - resource.data.points == getAfter(eventPath).data.pointsDelta
          && eventId == 'publication_' + postId
          && exists(postPath)
          && get(postPath).data.providerId == uid
          && request.resource.data.level == levelForPoints(request.resource.data.points);
      }

      allow read: if request.auth != null;
      allow create: if isValidNewUser();
      allow update: if request.auth != null
        && ((request.auth.uid == uid
              && request.resource.data.status == resource.data.status
              && request.resource.data.role == resource.data.role
              && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['points', 'level', 'lastPointEventId']))
          || (request.auth.uid == uid && isValidPointGrant())
          || (isModerator()
              && request.resource.data.status == 'BLOCKED'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /pointEvents/{eventId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && eventId == request.resource.data.eventId
          && eventId is string
          && eventId == 'publication_' + request.resource.data.sourcePostId
          && request.resource.data.userId == uid
          && request.resource.data.keys().hasOnly([
            'eventId', 'userId', 'sourcePostId', 'pointsDelta', 'createdAtMillis'
          ])
          && request.resource.data.sourcePostId is string
          && request.resource.data.pointsDelta == 50
          && request.resource.data.createdAtMillis is int
          && exists(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId))
          && get(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId)).data.providerId == uid
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastPointEventId == eventId
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.points
            == get(/databases/$(database)/documents/users/$(uid)).data.points + request.resource.data.pointsDelta;
        allow update, delete: if false;
      }

      match /badges/{badgeId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && badgeId in ['badge_1', 'badge_2', 'badge_3', 'badge_4']
          && request.resource.data.keys().hasOnly(['userId', 'badgeId', 'awardedAtMillis', 'sourcePostId'])
          && request.resource.data.userId == uid
          && request.resource.data.badgeId == badgeId
          && request.resource.data.awardedAtMillis is int
          && ((badgeId == 'badge_1'
                && request.resource.data.sourcePostId is string
                && exists(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId))
                && get(/databases/$(database)/documents/posts/$(request.resource.data.sourcePostId)).data.providerId == uid)
            || (badgeId == 'badge_2'
                && !('sourcePostId' in request.resource.data)
                && get(/databases/$(database)/documents/users/$(uid)).data.points >= 100)
            || (badgeId == 'badge_3'
                && !('sourcePostId' in request.resource.data)
                && get(/databases/$(database)/documents/users/$(uid)).data.points >= 250)
            || (badgeId == 'badge_4'
                && !('sourcePostId' in request.resource.data)
                && get(/databases/$(database)/documents/users/$(uid)).data.points >= 500));
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      function isValidLikeCountChange() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let likePath = /databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid);
        let previousCount = resource.data.get('upvotesCount', 0);
        let nextCount = request.resource.data.get('upvotesCount', 0);
        return request.auth != null
          && request.auth.uid != resource.data.providerId
          && changed.hasOnly(['upvotesCount'])
          && previousCount is int
          && nextCount is int
          && ((resource.data.status == 'APPROVED'
                && nextCount == previousCount + 1
                && !exists(likePath)
                && existsAfter(likePath)
                && getAfter(likePath).data.postId == postId
                && getAfter(likePath).data.userId == request.auth.uid)
            || (nextCount == previousCount - 1
                && exists(likePath)
                && !existsAfter(likePath)
                && get(likePath).data.postId == postId
                && get(likePath).data.userId == request.auth.uid));
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.status == 'PENDING_VERIFICATION';
      allow update: if request.auth != null && (
        (isModerator()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'moderatorId', 'rejectionReason', 'rejectionNotes', 'reportCount', 'moderatedAtMillis', 'moderatedAt']))
        || (request.auth.uid == resource.data.providerId
          && request.resource.data.providerId == resource.data.providerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'category', 'description', 'minPrice', 'maxPrice', 'isPriceToAgree',
            'locationDescription', 'location', 'photos', 'status'
          ])
          && (request.resource.data.status == resource.data.status
            || (resource.data.status in ['PENDING_VERIFICATION', 'APPROVED']
              && request.resource.data.status == 'PENDING_VERIFICATION')
            || (resource.data.status == 'APPROVED' && request.resource.data.status == 'FINISHED')))
        || isValidLikeCountChange()
      );
      allow delete: if request.auth != null
        && (isModerator() || request.auth.uid == resource.data.providerId);
    }

    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.clientId
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.providerId in request.resource.data.participants
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.providerId
          == request.resource.data.providerId;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastTime', 'deletedByUsers', 'status', 'unreadCounts'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if false;
      }
    }

    match /moderators/{moderatorId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == moderatorId;
    }

    match /reports/{reportId} {
      // Un usuario puede consultar su propio reporte; los moderadores pueden
      // consultar la cola de reportes pendientes.
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/reports/$(reportId))
          || resource.data.reporterId == request.auth.uid
          || isPostOwner(resource.data.targetPostId)
          || isModerator());
      allow list: if isModerator()
        || (request.auth != null && isPostOwner(resource.data.targetPostId));

      // Crear reportes únicamente para la cuenta autenticada y posts existentes.
      // La transacción del cliente lee el mismo ID determinista para impedir duplicados.
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && reportId == request.resource.data.targetPostId + '_' + request.auth.uid
        && request.resource.data.targetType == 'POST'
        && request.resource.data.targetPostId is string
        && request.resource.data.targetPostId.size() > 0
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.targetPostId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.targetPostId)).data.providerId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.status == 'PENDING'
        && request.resource.data.resolution == null
        && request.resource.data.resolvedAtMillis == null;

      // La resolución de reportes queda reservada a moderadores.
      allow update: if isModerator()
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.targetPostId == resource.data.targetPostId
        && request.resource.data.status == 'REVIEWED'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolution', 'moderatorComment', 'moderatorId', 'resolvedAtMillis']);
      allow delete: if false;
    }

    match /likes/{likeId} {
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/likes/$(likeId))
          || resource.data.userId == request.auth.uid
          || isModerator());
      allow list: if request.auth != null
        && (resource.data.userId == request.auth.uid || isModerator());
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'postId', 'userId', 'createdAtMillis'])
        && request.resource.data.id == likeId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() <= 256
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.createdAtMillis is int
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.status == 'APPROVED'
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.providerId != request.auth.uid
        && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.get('upvotesCount', 0)
          == get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.get('upvotesCount', 0) + 1;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid
        && likeId == resource.data.postId + '_' + request.auth.uid
        && getAfter(/databases/$(database)/documents/posts/$(resource.data.postId)).data.get('upvotesCount', 0)
          == get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.get('upvotesCount', 0) - 1;
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
          || resource.data.postOwnerId == request.auth.uid
          || isModerator()
          || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.status == 'APPROVED');
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'id', 'postId', 'postOwnerId', 'userId', 'authorName', 'content', 'createdAtMillis'
        ])
        && request.resource.data.id == commentId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.createdAtMillis is int
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.status == 'APPROVED'
        && request.resource.data.postOwnerId
          == get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.providerId;
      allow update, delete: if false;
    }

    // Resto de colecciones sigue cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
