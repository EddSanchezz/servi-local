rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model (phase 1 of the migration)
    //
    // users/{uid}: private profile fields (name, email, role, points,
    // level, createdAtMillis, photoUrl, lastAwardedPostId).
    //
    // moderators/{uid}: admin-managed moderator registry. Clients may read
    // their own record but may never create, update, or delete registry data.
    //
    // posts/{postId}: owner/provider fields, service details, one embedded
    // location map (latitude, longitude, coverageRadiusKm), Cloudinary URLs,
    // status, counts and timestamps. Owner edits service content only;
    // moderation fields are reserved for registered moderators.
    //
    // All other collections and subcollections are denied until their
    // Firebase repositories and validation rules are migrated.
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MODERATOR';
    }

    function validString(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }

    function validEmail(value) {
      return value is string
        && value.size() <= 254
        && value.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    function validHttpsUrl(value) {
      return value is string
        && value.size() <= 2048
        && value.matches('^https://[^ ]+$');
    }

    function validLevel(value) {
      return value in ['PRINCIPIANTE', 'PROFESIONAL', 'EXPERTO', 'MAESTRO'];
    }

    function levelForPoints(points) {
      return points >= 500 ? 'MAESTRO'
        : points >= 250 ? 'EXPERTO'
        : points >= 100 ? 'PROFESIONAL'
        : 'PRINCIPIANTE';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'points', 'level', 'createdAtMillis'])
        && data.keys().hasOnly([
          'name', 'email', 'role', 'points', 'level', 'createdAtMillis',
          'photoUrl', 'lastAwardedPostId'
        ])
        && validString(data.name, 1, 80)
        && validEmail(data.email)
        && data.role in ['USER', 'MODERATOR']
        && data.points is int
        && data.points >= 0
        && validLevel(data.level)
        && data.createdAtMillis is int
        && data.createdAtMillis > 0
        && (!('photoUrl' in data) || data.photoUrl == null || validHttpsUrl(data.photoUrl))
        && (!('lastAwardedPostId' in data)
          || validString(data.lastAwardedPostId, 1, 128));
    }

    function isValidModerator(data) {
      return data.keys().hasAll(['staffId', 'activeShift', 'workingHours'])
        && data.keys().hasOnly(['staffId', 'activeShift', 'workingHours'])
        && validString(data.staffId, 1, 32)
        && data.activeShift is bool
        && validString(data.workingHours, 1, 120);
    }

    function profileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'email', 'photoUrl']);
    }

    function validPublicationReward(uid) {
      let postId = request.resource.data.lastAwardedPostId;
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['points', 'level', 'lastAwardedPostId'])
        && postId is string
        && postId.size() > 0
        && postId != resource.data.get('lastAwardedPostId', '')
        && !exists(postPath)
        && getAfter(postPath).data.providerId == uid
        && getAfter(postPath).data.status == 'PENDING_VERIFICATION'
        && request.resource.data.points == resource.data.points + 50
        && request.resource.data.level == levelForPoints(request.resource.data.points)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAtMillis == resource.data.createdAtMillis
        && request.resource.data.get('photoUrl', null) == resource.data.get('photoUrl', null);
    }

    function validLocation(location) {
      return location is map
        && location.keys().hasAll(['latitude', 'longitude', 'coverageRadiusKm'])
        && location.keys().hasOnly(['latitude', 'longitude', 'coverageRadiusKm'])
        && location.latitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude is number
        && location.longitude >= -180
        && location.longitude <= 180
        && location.coverageRadiusKm is number
        && location.coverageRadiusKm > 0
        && location.coverageRadiusKm <= 500;
    }

    function validLocations(locations) {
      return locations is list
        && locations.size() == 1
        && validLocation(locations[0]);
    }

    function validPost(data) {
      return data.keys().hasAll([
          'providerId', 'providerName', 'providerLevel', 'title', 'category',
          'description', 'minPrice', 'maxPrice', 'isPriceToAgree',
          'locationDescription', 'locations', 'photos', 'status', 'upvotesCount',
          'reviewCount', 'rating', 'warrantyMonths', 'responseTime',
          'createdAtMillis', 'createdAt'
        ])
        && data.keys().hasOnly([
          'providerId', 'providerName', 'providerLevel', 'title', 'category',
          'description', 'minPrice', 'maxPrice', 'isPriceToAgree',
          'locationDescription', 'locations', 'photos', 'status', 'upvotesCount',
          'reviewCount', 'rating', 'warrantyMonths', 'responseTime',
          'createdAtMillis', 'createdAt', 'moderatorId', 'moderatedAt',
          'rejectionReason', 'rejectionNotes'
        ])
        && validString(data.providerId, 1, 128)
        && validString(data.providerName, 1, 80)
        && validString(data.providerLevel, 1, 40)
        && validString(data.title, 1, 80)
        && data.category in ['HOGAR', 'EDUCACION', 'MASCOTAS', 'TECNOLOGIA', 'TRANSPORTE']
        && validString(data.description, 1, 2000)
        && data.minPrice is int
        && data.minPrice >= 0
        && data.minPrice <= 100000000
        && data.maxPrice is int
        && data.maxPrice >= data.minPrice
        && data.maxPrice <= 100000000
        && data.isPriceToAgree is bool
        && validString(data.locationDescription, 1, 120)
        && validLocations(data.locations)
        && data.photos is list
        && data.photos.size() == 1
        && validHttpsUrl(data.photos[0])
        && data.status in ['PENDING_VERIFICATION', 'APPROVED', 'REJECTED', 'FINISHED']
        && data.upvotesCount is int
        && data.upvotesCount >= 0
        && data.reviewCount is int
        && data.reviewCount >= 0
        && data.rating is number
        && data.rating >= 0
        && data.rating <= 5
        && data.warrantyMonths is int
        && data.warrantyMonths >= 0
        && data.warrantyMonths <= 120
        && validString(data.responseTime, 0, 80)
        && data.createdAtMillis is int
        && data.createdAtMillis > 0
        && data.createdAt is timestamp
        && (!('moderatorId' in data) || data.moderatorId == null || validString(data.moderatorId, 1, 128))
        && (!('moderatedAt' in data) || data.moderatedAt == null || data.moderatedAt is timestamp)
        && (!('rejectionReason' in data) || data.rejectionReason == null || validString(data.rejectionReason, 1, 120))
        && (!('rejectionNotes' in data) || data.rejectionNotes == null || validString(data.rejectionNotes, 0, 1000));
    }

    function isOwnerPostUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'category', 'description', 'minPrice', 'maxPrice',
          'isPriceToAgree', 'locationDescription', 'locations', 'photos'
        ])
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdAtMillis == resource.data.createdAtMillis
        && request.resource.data.upvotesCount == resource.data.upvotesCount
        && request.resource.data.reviewCount == resource.data.reviewCount
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.get('moderatorId', null) == resource.data.get('moderatorId', null)
        && request.resource.data.get('moderatedAt', null) == resource.data.get('moderatedAt', null)
        && request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null)
        && request.resource.data.get('rejectionNotes', null) == resource.data.get('rejectionNotes', null)
        && validPost(request.resource.data);
    }

    function isOwnerFinishTransition() {
      return resource.data.providerId == request.auth.uid
        && resource.data.status == 'APPROVED'
        && request.resource.data.status == 'FINISHED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && validPost(request.resource.data);
    }

    function validModeratorTransition() {
      let oldStatus = resource.data.status;
      let newStatus = request.resource.data.status;
      return ((oldStatus == 'PENDING_VERIFICATION'
            && newStatus in ['APPROVED', 'REJECTED', 'FINISHED'])
          || (oldStatus == 'APPROVED' && newStatus in ['REJECTED', 'FINISHED']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderatorId', 'moderatedAt', 'rejectionReason', 'rejectionNotes'
        ])
        && request.resource.data.moderatorId == request.auth.uid
        && request.resource.data.moderatedAt == request.time
        && (newStatus != 'REJECTED' || validString(request.resource.data.rejectionReason, 1, 120))
        && validPost(request.resource.data);
    }

    match /users/{userId} {
      // Email and profile details are private; no client-side collection listing.
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'USER'
        && request.resource.data.points == 0
        && request.resource.data.level == 'PRINCIPIANTE';
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && (profileFieldsOnly() || validPublicationReward(userId));
      allow delete: if false;
    }

    match /moderators/{moderatorId} {
      // Registry documents are provisioned by a trusted project owner in Console.
      allow get: if isOwner(moderatorId)
        && (!exists(/databases/$(database)/documents/moderators/$(moderatorId))
          || isValidModerator(resource.data));
      allow list: if false;
      allow create, delete: if false;
      allow update: if isOwner(moderatorId)
        && isModerator()
        && isValidModerator(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeShift'])
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.workingHours == resource.data.workingHours;
    }

    match /posts/{postId} {
      allow get, list: if signedIn()
        && (resource.data.status == 'APPROVED'
          || resource.data.providerId == request.auth.uid
          || isModerator());

      allow create: if signedIn()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.providerName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.status == 'PENDING_VERIFICATION'
        && request.resource.data.createdAt == request.time
        && isValidPost(request.resource.data);

      allow update: if signedIn()
        && isValidPost(request.resource.data)
        && ((resource.data.providerId == request.auth.uid
              && (isOwnerPostUpdate() || isOwnerFinishTransition()))
          || (isModerator() && isValidModeratorTransition()));

      allow delete: if signedIn() && resource.data.providerId == request.auth.uid;
    }

    // Default deny for every collection not migrated yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
