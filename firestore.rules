rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Desarrollo: solo usuarios autenticados. Sin validación de campos.
    // Reemplazar por reglas con validación antes de producción.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /posts/{postId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /moderators/{moderatorId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == moderatorId;
    }

    // Resto de colecciones sigue cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}