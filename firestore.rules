rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Desarrollo: solo usuarios autenticados. Sin validacion de campos.
    // Reemplazar por reglas con validacion antes de produccion.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'ACTIVE';
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == resource.data.status;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /posts/{postId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /moderators/{moderatorId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == moderatorId;
    }

    // Resto de colecciones sigue cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
